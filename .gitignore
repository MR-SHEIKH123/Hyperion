node_modules/
/logs/
*.log

# Local configuration — may contain the bind address / paths for this machine
.env

# Never commit runtime data. The data root lives outside the repo by default
# (~/Hyperion), but guard against it being pointed here.
#
# The runtime-data patterns below are anchored with a leading slash on purpose.
# An unanchored pattern like `skills/` matches at every depth, which silently
# swallowed the whole `src/services/skills/` source tree — git never saw it.
# Anchoring keeps the guard on the data root, where it was aimed, without
# shadowing source directories that happen to share a name.
/data/
*.db
*.db-shm
*.db-wal
*.sqlite

# Encryption key material. If this is ever committed, every stored provider
# key must be considered compromised and rotated.
*.key
secret.key

/attachments/
/projects/
/skills/
/backups/
/tmp/
/mcp_config.json

# Editor/agent tooling, not part of the application. These are instructions for
# Cline about how to work on Hyperion; no src/ file imports them, tsconfig only
# includes src/ and test/, and `npm test` only globs test/. Deleting the
# directory changes nothing about how Hyperion builds or runs, so it does not
# belong in the project's history. The canonical copy lives in the user's global
# Cline rules directory — keeping a second one here only lets the two drift.
#
# Anchored, per the note above: unanchored it would also hide a source
# directory that happened to share the name.
/.clinerules/

.DS_Store
Thumbs.db

