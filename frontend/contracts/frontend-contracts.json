    {
      "id": "attention.approvals",
      "method": "GET",
      "expectedPath": "/api/attention",
      "status": "implemented",
      "reason": "Served by the queue rather than a separate /api/attention/approvals path: approvals arrive as items with kind approval_required, carrying the tool, task and the call that answers them."
    },
    {
      "id": "attention.interrupted",
      "method": "GET",
      "expectedPath": "/api/attention",
      "status": "implemented",
      "reason": "Served by the queue rather than a separate /api/attention/interrupted path: interrupted runs arrive as items with kind interrupted. The TaskRun contract carries the state too since migration 020 (boot reconciliation writes interrupted, not error), so an interruption is discoverable in both places it is read."
    },
